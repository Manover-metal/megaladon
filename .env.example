APP_NAME=Megaladon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=megaladon
DB_USERNAME=megaladon
DB_PASSWORD=secret

CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Путь к service-account JSON Firebase (не коммитим сам файл).
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- SMS-шлюз SMSC.kz (https://smsc.kz/api/http/) ---
# API-ключ из кабинета SMSC — если задан, заменяет пару логин+пароль
SMSC_API_KEY=
# Логин клиента SMSC (или логин API-подпользователя)
SMSC_LOGIN=
# Пароль. Если хранишь MD5-хеш пароля — поставь SMSC_PASSWORD_IS_MD5=true
SMSC_PASSWORD=
SMSC_PASSWORD_IS_MD5=false
# Имя отправителя, зарегистрированное в кабинете SMSC (пусто = общий номер)
SMSC_SENDER=
SMSC_URL=https://smsc.kz/sys/
SMSC_CHARSET=utf-8
SMSC_TRANSLIT=0
SMSC_TIMEOUT=10

# true — SMS реально не отправляются, код подтверждения приходит в ответе API
NO_SEND_SMS=true
# Статический код, который выдаётся при NO_SEND_SMS=true
SMS_DEBUG_CODE=101010
# Длина случайного кода при боевой отправке (4-8)
SMS_CODE_LENGTH=6
